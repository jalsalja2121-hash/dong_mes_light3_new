<UserControl x:Class="MpsMes.WPF.Views.EventLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg_Main}"
             TextElement.Foreground="{StaticResource Text_Primary}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 타이틀 + 새로고침 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="4" Height="18" Fill="{StaticResource Accent_Blue}" Margin="0,0,8,0"/>
                <TextBlock Text="■ 이벤트 로그 (최근 200건)" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource Text_Primary}"/>
            </StackPanel>
            <Button Content="새로고침" Style="{StaticResource Btn_Blue}"
                    Command="{Binding LoadCommand}"
                    HorizontalAlignment="Right" Height="26" Padding="14,0"/>
        </Grid>

        <!-- 로그 그리드 -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Logs}"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EventType}" Value="ERROR">
                            <Setter Property="Background" Value="#20D42828"/>
                            <Setter Property="Foreground" Value="{StaticResource Color_NG}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding EventType}" Value="WARN">
                            <Setter Property="Background" Value="#20EEF3FF"/>
                            <Setter Property="Foreground" Value="#FFFFD740"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding EventType}" Value="PLC">
                            <Setter Property="Foreground" Value="{StaticResource Accent_Cyan}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding EventType}" Value="VISION">
                            <Setter Property="Foreground" Value="{StaticResource Color_OK}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="SEQ"
                                    Binding="{Binding Seq}"
                                    Width="60"/>
                <DataGridTextColumn Header="발생 시각"
                                    Binding="{Binding EventAt, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}"
                                    Width="150"/>
                <DataGridTextColumn Header="유형"
                                    Binding="{Binding EventType}"
                                    Width="70"/>
                <DataGridTextColumn Header="코드"
                                    Binding="{Binding EventCode}"
                                    Width="90"/>
                <DataGridTextColumn Header="메시지"
                                    Binding="{Binding Message}"
                                    Width="*"/>
                <DataGridTextColumn Header="소스"
                                    Binding="{Binding Source}"
                                    Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

<UserControl x:Class="MpsMes.WPF.Views.ProductionHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MpsMes.WPF.Converters"
             Background="{StaticResource Bg_Main}"
             TextElement.Foreground="{StaticResource Text_Primary}">
    <UserControl.Resources>
        <conv:ResultToForegroundConverter x:Key="ResultToFg"/>
        <conv:ResultToBackgroundConverter x:Key="ResultToBg"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 타이틀 + 새로고침 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="4" Height="18" Fill="{StaticResource Accent_Blue}" Margin="0,0,8,0"/>
                <TextBlock Text="■ 생산 이력 (최근 100건)" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource Text_Primary}"/>
            </StackPanel>
            <Button Content="새로고침" Style="{StaticResource Btn_Blue}"
                    Command="{Binding LoadCommand}"
                    HorizontalAlignment="Right" Height="26" Padding="14,0"/>
        </Grid>

        <!-- 그리드 -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Records}"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SEQ"
                                    Binding="{Binding Seq}"
                                    Width="60"/>
                <DataGridTextColumn Header="완료 시각"
                                    Binding="{Binding CompletedAt, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}"
                                    Width="150"/>
                <DataGridTextColumn Header="사이클(초)"
                                    Binding="{Binding CycleTimeSec, StringFormat=\{0:F1\}}"
                                    Width="80"/>
                <DataGridTextColumn Header="금속 수량"
                                    Binding="{Binding MetalQty}"
                                    Width="80"/>
                <DataGridTextColumn Header="비금속 수량"
                                    Binding="{Binding NonMetalQty}"
                                    Width="90"/>
                <DataGridTextColumn Header="합 계"
                                    Binding="{Binding TotalQty}"
                                    Width="70"/>
                <DataGridTemplateColumn Header="비전 결과" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding VisionResult, Converter={StaticResource ResultToBg}}"
                                    CornerRadius="3" Padding="4,1" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding VisionResult}"
                                           FontWeight="Bold" FontSize="11"
                                           Foreground="{Binding VisionResult, Converter={StaticResource ResultToFg}}"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="결함 종류"
                                    Binding="{Binding DefectType}"
                                    Width="100"/>
                <DataGridTextColumn Header="신뢰도"
                                    Binding="{Binding Confidence, StringFormat=\{0:F1\}%}"
                                    Width="70"/>
                <DataGridTextColumn Header="교대조"
                                    Binding="{Binding ShiftCode}"
                                    Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

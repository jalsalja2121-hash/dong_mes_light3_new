<UserControl x:Class="MpsMes.WPF.Views.DbSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MpsMes.WPF.Converters"
             Background="{StaticResource Bg_Main}"
             TextElement.Foreground="{StaticResource Text_Primary}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 타이틀 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Rectangle Width="4" Height="18" Fill="{StaticResource Accent_Blue}" Margin="0,0,8,0"/>
            <TextBlock Text="■ DB 조회 / 검색" FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource Text_Primary}"/>
        </StackPanel>

        <!-- 검색 조건 -->
        <Border Grid.Row="1" Background="{StaticResource Bg_Card}"
                BorderBrush="{StaticResource Border_Normal}" BorderThickness="1"
                CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="날짜" FontSize="11"
                           Foreground="{StaticResource Text_Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding SearchFrom}"
                            Height="26" Margin="0,0,4,0"/>
                <TextBlock Grid.Column="2" Text="~" FontSize="12"
                           Foreground="{StaticResource Text_Secondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Grid.Column="3" Text="" VerticalAlignment="Center" Width="0"/>
                <DatePicker Grid.Column="4" SelectedDate="{Binding SearchTo}"
                            Height="26" Margin="0,0,10,0"/>

                <TextBlock Grid.Column="5" Text="결과" FontSize="11"
                           Foreground="{StaticResource Text_Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="6" SelectedValue="{Binding SearchResult}"
                          Height="26" Margin="0,0,10,0">
                    <ComboBoxItem Content="전체"/>
                    <ComboBoxItem Content="OK"/>
                    <ComboBoxItem Content="NG"/>
                </ComboBox>

                <TextBlock Grid.Column="7" Text="분류" FontSize="11"
                           Foreground="{StaticResource Text_Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Column="8" Text="{Binding SearchDefect}"
                         Height="26" Margin="0,0,10,0"/>

                <StackPanel Grid.Column="10" Orientation="Horizontal">
                    <Button Content="⟳ 생산이력 조회" Style="{StaticResource Btn_Blue}"
                            Command="{Binding SearchProductionCommand}"
                            Height="26" Padding="10,0" Margin="0,0,4,0"/>
                    <Button Content="🔍 비전검사 조회" Style="{StaticResource Btn_Blue}"
                            Command="{Binding SearchVisionCommand}"
                            Height="26" Padding="10,0" Margin="0,0,4,0"/>
                    <Button Content="📋 이벤트로그 조회" Style="{StaticResource Btn_Default}"
                            Command="{Binding SearchEventCommand}"
                            Height="26" Padding="10,0" Margin="0,0,4,0"/>
                    <Button Content="⟲ 필터 초기화" Style="{StaticResource Btn_Default}"
                            Command="{Binding ClearFilterCommand}"
                            Height="26" Padding="10,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 결과 탭 -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTab}">

            <!-- 생산이력 -->
            <TabItem Header="⟳ 생산이력">
                <DataGrid ItemsSource="{Binding ProdResults}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SEQ"        Binding="{Binding Seq}"           Width="60"/>
                        <DataGridTextColumn Header="완료 시각"   Binding="{Binding CompletedAt, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="150"/>
                        <DataGridTextColumn Header="사이클(초)"  Binding="{Binding CycleTimeSec}"  Width="80"/>
                        <DataGridTextColumn Header="금속"        Binding="{Binding MetalQty}"      Width="60"/>
                        <DataGridTextColumn Header="비금속"      Binding="{Binding NonMetalQty}"   Width="60"/>
                        <DataGridTextColumn Header="합계"        Binding="{Binding TotalQty}"      Width="60"/>
                        <DataGridTextColumn Header="비전결과"    Binding="{Binding VisionResult}"  Width="70"/>
                        <DataGridTextColumn Header="결함종류"    Binding="{Binding DefectType}"    Width="100"/>
                        <DataGridTextColumn Header="신뢰도"      Binding="{Binding Confidence, StringFormat=\{0:F1\}%}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- 비전검사 -->
            <TabItem Header="🔍 비전검사">
                <DataGrid ItemsSource="{Binding VisionResults}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SEQ"       Binding="{Binding Seq}"            Width="60"/>
                        <DataGridTextColumn Header="검사 시각"  Binding="{Binding InspectedAt, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="150"/>
                        <DataGridTextColumn Header="결과"       Binding="{Binding Result}"         Width="60"/>
                        <DataGridTextColumn Header="결함 종류"  Binding="{Binding DefectType}"     Width="100"/>
                        <DataGridTextColumn Header="신뢰도"     Binding="{Binding Confidence, StringFormat=\{0:F1\}%}" Width="70"/>
                        <DataGridTextColumn Header="재질"       Binding="{Binding MaterialType}"   Width="70"/>
                        <DataGridTextColumn Header="이미지경로" Binding="{Binding ImagePath}"      Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- 이벤트 로그 -->
            <TabItem Header="📋 이벤트로그">
                <DataGrid ItemsSource="{Binding EventResults}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SEQ"       Binding="{Binding Seq}"            Width="60"/>
                        <DataGridTextColumn Header="발생 시각"  Binding="{Binding EventAt, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="150"/>
                        <DataGridTextColumn Header="유형"       Binding="{Binding EventType}"      Width="70"/>
                        <DataGridTextColumn Header="코드"       Binding="{Binding EventCode}"      Width="80"/>
                        <DataGridTextColumn Header="메시지"     Binding="{Binding Message}"        Width="*"/>
                        <DataGridTextColumn Header="소스"       Binding="{Binding Source}"         Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>

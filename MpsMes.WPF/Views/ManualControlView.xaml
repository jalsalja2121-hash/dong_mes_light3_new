<UserControl x:Class="MpsMes.WPF.Views.ManualControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg_Main}"
             TextElement.Foreground="{StaticResource Text_Primary}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Rectangle Width="4" Height="18" Fill="{StaticResource Accent_Blue}" Margin="0,0,8,0"/>
            <TextBlock Text="■ 수동 조작 — 실린더 / 모터 개별 제어"
                       FontSize="15" FontWeight="Bold" Foreground="{StaticResource Text_Primary}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- 실린더 제어 -->
            <GroupBox Grid.Column="0" Header="실린더 제어 (벨스 출력)" Margin="0,0,6,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">

                        <!-- 공급 실린더 전진 M3000 -->
                        <Grid Height="34" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="공급 실린더 전진" FontSize="12"
                                       Foreground="{StaticResource Text_Secondary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="▶ 동작"
                                    Style="{StaticResource Btn_Default}"
                                    Command="{Binding ToggleCoilCommand}"
                                    CommandParameter="M3000" Height="28"/>
                        </Grid>

                        <!-- 공급 실린더 후진 M3001 -->
                        <Grid Height="34" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="공급 실린더 후진" FontSize="12"
                                       Foreground="{StaticResource Text_Secondary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="▶ 동작"
                                    Style="{StaticResource Btn_Default}"
                                    Command="{Binding ToggleCoilCommand}"
                                    CommandParameter="M3001" Height="28"/>
                        </Grid>

                        <!-- 분배 실린더 전진 M3002 -->
                        <Grid Height="34" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="분배 실린더 전진" FontSize="12"
                                       Foreground="{StaticResource Text_Secondary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="▶ 동작"
                                    Style="{StaticResource Btn_Default}"
                                    Command="{Binding ToggleCoilCommand}"
                                    CommandParameter="M3002" Height="28"/>
                        </Grid>

                        <!-- 분배 실린더 후진 M3003 -->
                        <Grid Height="34" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="분배 실린더 후진" FontSize="12"
                                       Foreground="{StaticResource Text_Secondary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="▶ 동작"
                                    Style="{StaticResource Btn_Default}"
                                    Command="{Binding ToggleCoilCommand}"
                                    CommandParameter="M3003" Height="28"/>
                        </Grid>

                        <!-- 가공 실린더 하강 M3004 -->
                        <Grid Height="34" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="가공 실린더 하강" FontSize="12"
                                       Foreground="{StaticResource Text_Secondary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="▶ 동작"
                                    Style="{StaticResource Btn_Default}"
                                    Command="{Binding ToggleCoilCommand}"
                                    CommandParameter="M3004" Height="28"/>
                        </Grid>

                        <!-- 배출 실린더 전진 M3006 -->
                        <Grid Height="34" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="배출 실린더 전진" FontSize="12"
                                       Foreground="{StaticResource Text_Secondary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="▶ 동작"
                                    Style="{StaticResource Btn_Default}"
                                    Command="{Binding ToggleCoilCommand}"
                                    CommandParameter="M3006" Height="28"/>
                        </Grid>

                        <!-- 스토퍼 실린더 하강 M3008 -->
                        <Grid Height="34" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="스토퍼 실린더 하강" FontSize="12"
                                       Foreground="{StaticResource Text_Secondary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="▶ 동작"
                                    Style="{StaticResource Btn_Default}"
                                    Command="{Binding ToggleCoilCommand}"
                                    CommandParameter="M3008" Height="28"/>
                        </Grid>

                        <!-- 스토퍼 실린더 상승 M3009 -->
                        <Grid Height="34" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="스토퍼 실린더 상승" FontSize="12"
                                       Foreground="{StaticResource Text_Secondary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="▶ 동작"
                                    Style="{StaticResource Btn_Default}"
                                    Command="{Binding ToggleCoilCommand}"
                                    CommandParameter="M3009" Height="28"/>
                        </Grid>

                        <!-- 흡착 실린더 전진 M3010 -->
                        <Grid Height="34" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="흡착 실린더 전진" FontSize="12"
                                       Foreground="{StaticResource Text_Secondary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="▶ 동작"
                                    Style="{StaticResource Btn_Default}"
                                    Command="{Binding ToggleCoilCommand}"
                                    CommandParameter="M3010" Height="28"/>
                        </Grid>

                        <!-- 흡착 실린더 후진 M3011 -->
                        <Grid Height="34" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="흡착 실린더 후진" FontSize="12"
                                       Foreground="{StaticResource Text_Secondary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="▶ 동작"
                                    Style="{StaticResource Btn_Default}"
                                    Command="{Binding ToggleCoilCommand}"
                                    CommandParameter="M3011" Height="28"/>
                        </Grid>

                        <!-- 저장 실린더 전진 M3012 -->
                        <Grid Height="34" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="저장 실린더 전진" FontSize="12"
                                       Foreground="{StaticResource Text_Secondary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="▶ 동작"
                                    Style="{StaticResource Btn_Default}"
                                    Command="{Binding ToggleCoilCommand}"
                                    CommandParameter="M3012" Height="28"/>
                        </Grid>

                        <!-- 저장 실린더 후진 M3013 -->
                        <Grid Height="34" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="저장 실린더 후진" FontSize="12"
                                       Foreground="{StaticResource Text_Secondary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="▶ 동작"
                                    Style="{StaticResource Btn_Default}"
                                    Command="{Binding ToggleCoilCommand}"
                                    CommandParameter="M3013" Height="28"/>
                        </Grid>

                        <!-- 흡착 ON M3014 -->
                        <Grid Height="34" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="흡착 ON" FontSize="12"
                                       Foreground="{StaticResource Accent_Blue}" VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                            <Button Grid.Column="2" Content="▶ 동작"
                                    Style="{StaticResource Btn_Default}"
                                    Command="{Binding ToggleCoilCommand}"
                                    CommandParameter="M3014" Height="28"
                                    Foreground="{StaticResource Accent_Blue}"
                                    BorderBrush="{StaticResource Color_Warn}"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <!-- 우측: 모터 -->
            <GroupBox Grid.Column="1" Header="모터 (토글)">
                <StackPanel Margin="8">

                    <!-- PROCESS 모터 M3015 -->
                    <Border Background="{StaticResource Bg_Card}"
                            BorderBrush="{StaticResource Color_Running}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="PROCESS 모터" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text_Primary}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource Btn_Default}"
                                    Command="{Binding ToggleCoilCommand}"
                                    CommandParameter="M3015"
                                    Width="75" Height="34"
                                    BorderBrush="{StaticResource Color_Running}"
                                    Foreground="{StaticResource Color_Running}"
                                    FontWeight="Bold" FontSize="12">
                                <TextBlock Text="▶ 동작"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- CONVEYOR 모터 M3016 -->
                    <Border Background="{StaticResource Bg_Card}"
                            BorderBrush="{StaticResource Color_Running}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="CONVEYOR 모터" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text_Primary}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource Btn_Default}"
                                    Command="{Binding ToggleCoilCommand}"
                                    CommandParameter="M3016"
                                    Width="75" Height="34"
                                    BorderBrush="{StaticResource Color_Running}"
                                    Foreground="{StaticResource Color_Running}"
                                    FontWeight="Bold" FontSize="12">
                                <TextBlock Text="▶ 동작"/>
                            </Button>
                        </Grid>
                    </Border>

                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>

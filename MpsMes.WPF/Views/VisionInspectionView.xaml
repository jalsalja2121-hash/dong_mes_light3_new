<UserControl x:Class="MpsMes.WPF.Views.VisionInspectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MpsMes.WPF.Converters"
             Background="{StaticResource Bg_Main}"
             TextElement.Foreground="{StaticResource Text_Primary}">
    <UserControl.Resources>
        <conv:ResultToBackgroundConverter x:Key="ResultToBg"/>
        <conv:ResultToForegroundConverter x:Key="ResultToFg"/>
        <conv:BoolToVisibilityConverter   x:Key="BoolToVis"/>
        <conv:PercentageConverter         x:Key="Pct"/>
        <conv:InverseBoolConverter        x:Key="InvBool"/>
        <conv:CameraButtonTextConverter   x:Key="CamBtnText"/>
        <conv:BoolToLedBrushConverter     x:Key="BoolToLed"/>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>

        <!-- 카메라 영역 -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <!-- 컨트롤 행 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="카메라 선택"
                               FontSize="13" Foreground="{StaticResource Text_Muted}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableCameras}"
                              DisplayMemberPath="Name" SelectedValuePath="Index"
                              SelectedValue="{Binding SelectedCameraIndex}"
                              Margin="0,0,8,0"/>
                    <Border Grid.Column="2"
                            Background="{StaticResource Bg_Card}"
                            BorderBrush="{StaticResource Border_Normal}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="10,0" Height="32" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="장치 # " FontSize="13"
                                       Foreground="{StaticResource Text_Muted}"/>
                            <TextBlock Text="{Binding SelectedCameraIndex}"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource Accent_Blue}"/>
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="3" Content="카메라 스캔"
                            Style="{StaticResource Btn_Default}"
                            Command="{Binding ScanCamerasCommand}"
                            Foreground="{StaticResource Accent_Blue}"
                            BorderBrush="{StaticResource Accent_Blue}"
                            IsEnabled="{Binding IsCameraRunning, Converter={StaticResource InvBool}}"/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Border Background="{StaticResource Accent_Blue}"
                            CornerRadius="4" Padding="10,5" Margin="0,0,6,0">
                        <TextBlock Text="비전 검사 모니터링" FontSize="13" FontWeight="Bold"
                                   Foreground="White"/>
                    </Border>
                    <Button Style="{StaticResource Btn_Blue}"
                            Command="{Binding ToggleCameraCommand}"
                            Padding="12,0" Margin="0,0,6,0">
                        <TextBlock>
                            <Run Text="{Binding IsCameraRunning, Converter={StaticResource CamBtnText}}"/>
                        </TextBlock>
                    </Button>
                    <Button Content="모델 로드" Style="{StaticResource Btn_Default}"
                            Command="{Binding LoadModelCommand}"
                            Foreground="{StaticResource Accent_Blue}"
                            BorderBrush="{StaticResource Accent_Blue}"
                            Padding="12,0" Margin="0,0,6,0"/>
                    <Button Content="촬영 + 검사" 
                        Style="{StaticResource Btn_Default}"
                        Command="{Binding InspectCommand}"
                        Background="{StaticResource Accent_Blue}"
                        Foreground="White"
                        BorderBrush="{StaticResource Accent_Blue}"
                        Padding="12,0" 
                        Margin="0,0,6,0"
                        IsEnabled="{Binding IsCameraRunning}"/>
                    <Border Background="{StaticResource Bg_Card}"
                            BorderBrush="{StaticResource Border_Normal}"
                            BorderThickness="1" CornerRadius="4" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding IsModelLoaded, Converter={StaticResource BoolToLed}}"/>
                            <TextBlock Text="{Binding ModelStatusText}" FontSize="13"
                                       Foreground="{StaticResource Text_Secondary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="{StaticResource Text_Muted}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SelectedModelPath}">
                    <Run Text="선택 모델: "/>
                    <Run Text="{Binding SelectedModelPath}"/>
                </TextBlock>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="현재 재질: " FontSize="12"
                               Foreground="{StaticResource Text_Muted}"/>
                    <TextBlock Text="{Binding CurrentMaterialType}" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource Accent_Blue}" Margin="0,0,14,0"/>
                    <TextBlock Text="금속 누적 " FontSize="12"
                               Foreground="{StaticResource Text_Muted}"/>
                    <TextBlock Text="{Binding CurrentMetalQty}" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource Accent_Blue}" Margin="0,0,10,0"/>
                    <TextBlock Text="비금속 누적 " FontSize="12"
                               Foreground="{StaticResource Text_Muted}"/>
                    <TextBlock Text="{Binding CurrentNonMetalQty}" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource Accent_Cyan}"/>
                </StackPanel>
            </Grid>

            <!-- 카메라 영상 -->
            <Border Grid.Row="1" Background="#FF0D1520"
                    BorderBrush="{StaticResource Border_Normal}"
                    BorderThickness="1" CornerRadius="8"
                    Margin="0,0,0,8">
                <Grid>
                    <Image Source="{Binding CurrentFrame}" Stretch="Uniform"/>
                </Grid>
            </Border>

            <!-- 검사 이력 -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding RecentResults}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="시각"
                                        Binding="{Binding InspectedAt, StringFormat=\{0:HH:mm:ss\}}" Width="90"/>
                    <DataGridTextColumn Header="결과" Binding="{Binding Result}" Width="60"/>
                    <DataGridTextColumn Header="재질" Binding="{Binding MaterialType}" Width="70"/>
                    <DataGridTextColumn Header="결함 종류" Binding="{Binding DefectType}" Width="*"/>
                    <DataGridTextColumn Header="신뢰도"
                                        Binding="{Binding Confidence, StringFormat=\{0:F1\}%}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 결과 패널 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="판정 결과" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource Text_Muted}" Margin="0,0,0,8"/>

            <Border Grid.Row="1" Height="90" Margin="0,0,0,10"
                    Background="{Binding VisionResult, Converter={StaticResource ResultToBg}}"
                    BorderBrush="{Binding VisionResult, Converter={StaticResource ResultToFg}}"
                    BorderThickness="2" CornerRadius="8">
                <TextBlock Text="{Binding VisionResult}"
                           FontSize="42" FontWeight="Black" FontFamily="Consolas"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{Binding VisionResult, Converter={StaticResource ResultToFg}}"/>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource Bg_Card}"
                    BorderBrush="{StaticResource Border_Normal}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="12,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="결함 종류"
                               FontSize="13" Foreground="{StaticResource Text_Muted}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding DefectType, FallbackValue='—'}"
                               FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource Color_NG}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Row="1" Grid.ColumnSpan="2"
                            Background="{StaticResource Border_Normal}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="신뢰도"
                               FontSize="13" Foreground="{StaticResource Text_Muted}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding Confidence, Converter={StaticResource Pct}}"
                               FontSize="20" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="{StaticResource Accent_Blue}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Row="3" Grid.ColumnSpan="2"
                            Background="{StaticResource Border_Normal}"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="재질"
                               FontSize="13" Foreground="{StaticResource Text_Muted}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="1"
                               Text="{Binding LastInspectionMaterialType}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource Accent_Blue}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="3" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- OK 박스 -->
                <Border Grid.Column="0"
                        Background="{StaticResource Color_OK}"
                        CornerRadius="10"
                        Margin="0,0,6,0" Height="130">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="OK"
                                   FontSize="28" FontWeight="Black"
                                   FontFamily="Consolas"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding OkCount}"
                                   FontSize="52" FontWeight="Black"
                                   FontFamily="Consolas"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   LineHeight="52"/>
                    </StackPanel>
                </Border>

                <!-- NG 박스 -->
                <Border Grid.Column="1"
                        Background="{StaticResource Color_NG}"
                        CornerRadius="10"
                        Margin="6,0,0,0" Height="130">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="NG"
                                   FontSize="28" FontWeight="Black"
                                   FontFamily="Consolas"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding NgCount}"
                                   FontSize="52" FontWeight="Black"
                                   FontFamily="Consolas"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   LineHeight="52"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="MpsMes.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MpsMes.WPF.Converters"
        xmlns:views="clr-namespace:MpsMes.WPF.Views"
        Title="MPS 간이 MES 시스템" Height="768" Width="1366"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg_Main}"
        Foreground="{StaticResource Text_Primary}"
        TextElement.Foreground="{StaticResource Text_Primary}"
        FontFamily="Malgun Gothic">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/BlueTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToLedBrushConverter     x:Key="BoolToLed"/>
            <conv:PlcStatusToColorConverter   x:Key="PlcStatusToColor"/>
            <conv:PlcStatusToTextConverter    x:Key="PlcStatusToText"/>
            <conv:ResultToBackgroundConverter x:Key="ResultToBg"/>
            <conv:ResultToForegroundConverter x:Key="ResultToFg"/>
            <conv:BoolToVisibilityConverter   x:Key="BoolToVis"/>
            <conv:InverseBoolConverter        x:Key="InvBool"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ 헤더 ════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource Bg_Header}"
                TextElement.Foreground="White">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="6"
                            Background="#FF2E6FD4" Margin="0,0,12,0">
                        <TextBlock Text="M" FontSize="17" FontWeight="Black"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MPS 간이 MES 시스템"
                               FontSize="17" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding CurrentTime}"
                           FontSize="15" FontWeight="SemiBold"
                           FontFamily="Consolas"
                           Foreground="#FFB8CEEC"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ 본문 ════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── 사이드바 (파란 배경) ──────────────────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource Bg_Panel}"
                    BorderBrush="#FF1646A0"
                    BorderThickness="0,0,1,0"
                    TextElement.Foreground="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,14,12,14">

                        <!-- PLC 상태 표시 -->
                        <Border Background="#FF1646A0"
                                CornerRadius="8"
                                TextElement.Foreground="White"
                                Padding="12,10"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="12" Height="12"
                                         Margin="0,0,9,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding PlcStatus, Converter={StaticResource PlcStatusToColor}}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PlcStatus, Converter={StaticResource PlcStatusToText}}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="PLC" FontSize="11"
                                           Foreground="#FFB8CEEC"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- PLC 연결/해제 버튼 -->
                        <Button Content="{Binding PlcConnectLabel}"
                                Style="{StaticResource Btn_Blue}"
                                Command="{Binding TogglePlcConnectionCommand}"
                                Background="White"
                                Foreground="{StaticResource Accent_Blue}"
                                BorderBrush="White"
                                Height="36" Margin="0,0,0,14"
                                FontSize="14" FontWeight="Bold"/>

                        <!-- 구분선 -->
                        <Border Height="1" Background="#FF1646A0" Margin="0,0,0,12"/>

                        <!-- 운전 모드 -->
                        <TextBlock Text="운전 모드" FontSize="12"
                                   Foreground="#FFB8CEEC"
                                   Margin="2,0,0,7" FontWeight="SemiBold"/>
                        <Border Background="#FF1646A0" CornerRadius="7"
                                Padding="10,9" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <!-- 정지중 -->
                                <StackPanel HorizontalAlignment="Center" Width="64">
                                    <Ellipse Width="14" Height="14" HorizontalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStop}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Color_NG}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsStop}" Value="False">
                                                        <Setter Property="Fill" Value="#FF3A6FC0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="정지중" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" Foreground="White"/>
                                </StackPanel>
                                <!-- 리셋중 -->
                                <StackPanel HorizontalAlignment="Center" Width="64">
                                    <Ellipse Width="14" Height="14" HorizontalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReset}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Color_Warn}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsReset}" Value="False">
                                                        <Setter Property="Fill" Value="#FF3A6FC0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="리셋중" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" Foreground="White"/>
                                </StackPanel>
                                <!-- 운전중 -->
                                <StackPanel HorizontalAlignment="Center" Width="64">
                                    <Ellipse Width="14" Height="14" HorizontalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAuto}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Color_OK}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAuto}" Value="False">
                                                        <Setter Property="Fill" Value="#FF3A6FC0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="운전중" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" Foreground="White"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 운전 제어 버튼 3개 -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource Btn_Default}"
                                    Command="{Binding StopCommand}"
                                    Height="38" Margin="0,0,3,0"
                                    Background="#FFFDE8E8"
                                    BorderBrush="{StaticResource Color_NG}"
                                    Foreground="{StaticResource Color_NG}"
                                    FontSize="13" FontWeight="Bold">
                                <TextBlock Text="■ 정지"/>
                            </Button>
                            <Button Grid.Column="1"
                                    Style="{StaticResource Btn_Default}"
                                    Command="{Binding ResetCommand}"
                                    Height="38" Margin="2,0"
                                    Background="#FFF0F5FF"
                                    BorderBrush="{StaticResource Accent_Blue}"
                                    Foreground="{StaticResource Accent_Blue}"
                                    FontSize="13" FontWeight="Bold">
                                <TextBlock Text="↺ 리셋"/>
                            </Button>
                            <Button Grid.Column="2"
                                    Style="{StaticResource Btn_Default}"
                                    Command="{Binding StartCommand}"
                                    Height="38" Margin="3,0,0,0"
                                    Background="#FFE8F5ED"
                                    BorderBrush="{StaticResource Color_OK}"
                                    Foreground="{StaticResource Color_OK}"
                                    FontSize="13" FontWeight="Bold">
                                <TextBlock Text="▶ 시작"/>
                            </Button>
                        </Grid>

                        <!-- 구분선 -->
                        <Border Height="1" Background="#FF1646A0" Margin="0,0,0,12"/>

                        <!-- 생산 수량 -->
                        <TextBlock Text="생산 수량" FontSize="12"
                                   Foreground="#FFB8CEEC"
                                   Margin="2,0,0,7" FontWeight="SemiBold"/>
                        <Border Background="#FF1646A0" CornerRadius="7"
                                Padding="12,10" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="32"/>
                                </Grid.RowDefinitions>
                                <!-- 금속 -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="금속 수량" FontSize="13"
                                           Foreground="#FFB8CEEC"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding MetalQty}"
                                           FontSize="15" FontWeight="Bold"
                                           FontFamily="Consolas"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                                <!-- 비금속 -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="비금속 수량" FontSize="13"
                                           Foreground="#FFB8CEEC"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding NonMetalQty}"
                                           FontSize="15" FontWeight="Bold"
                                           FontFamily="Consolas"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                                <!-- 구분선 -->
                                <Border Grid.Row="2" Grid.ColumnSpan="2"
                                        Height="1" Background="#FF2E6FD4"
                                        VerticalAlignment="Center"/>
                                <!-- 합계 -->
                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="합  계" FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{Binding TotalQty}"
                                           FontSize="20" FontWeight="Black"
                                           FontFamily="Consolas"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 서보모터 -->
                        <TextBlock Text="서보 모터" FontSize="12"
                                   Foreground="#FFB8CEEC"
                                   Margin="2,0,0,7" FontWeight="SemiBold"/>
                        <Border Background="#FF1646A0" CornerRadius="7"
                                Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="위  치" FontSize="13"
                                               Foreground="#FFB8CEEC"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1"
                                                Orientation="Horizontal">
                                        <TextBlock Text="{Binding ServoPos}"
                                                   FontSize="15" FontWeight="Bold"
                                                   FontFamily="Consolas"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text=" mm" FontSize="11"
                                                   Foreground="#FFB8CEEC"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="상  태" FontSize="13"
                                               Foreground="#FFB8CEEC"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding ServoStatus}"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource Color_OK}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Button Style="{StaticResource Btn_Default}"
                                        Command="{Binding ServoInitCommand}"
                                        Background="White"
                                        Foreground="{StaticResource Accent_Blue}"
                                        BorderBrush="White"
                                        Height="32" FontSize="12" FontWeight="Bold"
                                        Content="서보 원점 초기화"/>
                            </StackPanel>
                        </Border>

                        <!-- 구분선 -->
                        <Border Height="1" Background="#FF1646A0" Margin="0,4,0,12"/>

                        <!-- 비전 검사 -->
                        <TextBlock Text="비전 검사" FontSize="12"
                                   Foreground="#FFB8CEEC"
                                   Margin="2,0,0,7" FontWeight="SemiBold"/>

                        <!-- 카메라 상태 -->
                        <Border Background="#FF1646A0" CornerRadius="7"
                                Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="10" Height="10" Margin="0,0,7,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding IsCameraConnected, Converter={StaticResource BoolToLed}}"/>
                                    <TextBlock FontSize="13" Foreground="White">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCameraConnected}" Value="True">
                                                        <Setter Property="Text" Value="카메라 연결됨"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCameraConnected}" Value="False">
                                                        <Setter Property="Text" Value="카메라 미연결"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Color_NG}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <Button Content="카메라 연결 / 해제"
                                        Style="{StaticResource Btn_Default}"
                                        Command="{Binding ToggleCameraCommand}"
                                        Background="White"
                                        Foreground="{StaticResource Accent_Blue}"
                                        BorderBrush="White"
                                        Height="32" FontSize="12" FontWeight="Bold"
                                        Margin="0,0,0,8"/>

                                <!-- 비전 결과 배지 -->
                                <Border Height="48"
                                        Background="{Binding VisionResult, Converter={StaticResource ResultToBg}}"
                                        BorderBrush="{Binding VisionResult, Converter={StaticResource ResultToFg}}"
                                        BorderThickness="2" CornerRadius="6"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="{Binding VisionResult}"
                                               FontSize="22" FontWeight="Bold"
                                               FontFamily="Consolas"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding VisionResult, Converter={StaticResource ResultToFg}}"/>
                                </Border>

                                <!-- OK / NG 카운트 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="#FFE8F5ED"
                                            BorderBrush="{StaticResource Color_OK}"
                                            BorderThickness="1.5" CornerRadius="5"
                                            Margin="0,0,4,0" Height="44">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="OK" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource Color_OK}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding VisionOkCount}"
                                                       FontSize="16" FontWeight="Black"
                                                       FontFamily="Consolas"
                                                       Foreground="{StaticResource Color_OK}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1"
                                            Background="#FFFDE8E8"
                                            BorderBrush="{StaticResource Color_NG}"
                                            BorderThickness="1.5" CornerRadius="5"
                                            Margin="4,0,0,0" Height="44">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="NG" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource Color_NG}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding VisionNgCount}"
                                                       FontSize="16" FontWeight="Black"
                                                       FontFamily="Consolas"
                                                       Foreground="{StaticResource Color_NG}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── 우측 탭 콘텐츠 ────────────────────────────── -->
            <Grid Grid.Column="1" Background="{StaticResource Bg_Main}"
                    TextElement.Foreground="{StaticResource Text_Primary}">
                <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                            Background="{StaticResource Bg_Main}"
                            BorderBrush="{StaticResource Border_Normal}"
                            BorderThickness="0,1,0,0">
                    <TabItem Header="모니터링">
                        <views:MonitorView DataContext="{Binding MonitorVm}"/>
                    </TabItem>
                    <TabItem Header="비전검사">
                        <views:VisionInspectionView DataContext="{Binding VisionInspectionVm}"/>
                    </TabItem>
                    <TabItem Header="수동 조작">
                        <views:ManualControlView DataContext="{Binding ManualControlVm}"/>
                    </TabItem>
                    <TabItem Header="🔍 품질 분석">
                        <views:QualityAnalysisView DataContext="{Binding QualityAnalysisVm}"/>
                    </TabItem>
                    <TabItem Header="📊 생산현황">
                        <views:ProductionStatusView DataContext="{Binding ProductionStatusVm}"/>
                    </TabItem>
                    <TabItem Header="📋 DB 조회">
                        <views:DbSearchView DataContext="{Binding DbSearchVm}"/>
                    </TabItem>
                    <TabItem Header="생산 이력">
                        <views:ProductionHistoryView DataContext="{Binding ProductionHistoryVm}"/>
                    </TabItem>
                    <TabItem Header="이벤트 로그">
                        <views:EventLogView DataContext="{Binding EventLogVm}"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>

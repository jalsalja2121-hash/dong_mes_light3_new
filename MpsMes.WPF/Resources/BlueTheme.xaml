<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ================================================================
     MPS MES — Blue Light Theme
     색상 4계열 원칙
     ┌──────────────────────────────────────────────────────────┐
     │ 1. 파랑  Blue   #1A54AF  사이드바·헤더·강조·버튼·탭선  │
     │ 2. 흰회색 White #FFFFFF  배경·카드·입력                  │
     │ 3. 초록  Green  #1B8A3C  OK·정상·통과                   │
     │ 4. 빨강  Red    #D42828  NG·오류·정지                    │
     └──────────────────────────────────────────────────────────┘
     모든 기존 리소스 키 유지 (Binding 변경 없음)
    ================================================================
    -->

    <!-- ═══════════════════════════════════════════════════════
         배경 계층 — 흰색 기반
         ═══════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="Bg_Deep"    Color="#FFEAF0F8"/>   <!-- 최하단 앱 배경 -->
    <SolidColorBrush x:Key="Bg_Main"    Color="#FFEAF0F8"/>   <!-- 주 콘텐츠 배경 -->
    <SolidColorBrush x:Key="Bg_Panel"   Color="#FF1A54AF"/>   <!-- 사이드바 패널 (파란) -->
    <SolidColorBrush x:Key="Bg_Card"    Color="#FFFFFFFF"/>   <!-- 카드 (흰) -->
    <SolidColorBrush x:Key="Bg_Input"   Color="#FFF4F7FB"/>   <!-- 입력·대체행 (연회) -->
    <SolidColorBrush x:Key="Bg_Header"  Color="#FF1646A0"/>   <!-- 헤더 (짙은 파랑) -->

    <!-- ═══════════════════════════════════════════════════════
         강조색 — 파랑 계열
         Accent_Blue 키 유지
         ═══════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="Accent_Blue"  Color="#FF1A54AF"/>  <!-- 주 파랑 -->
    <SolidColorBrush x:Key="Accent_Cyan"  Color="#FF2E6FD4"/>  <!-- 밝은 파랑 (선택·호버) -->

    <!-- ═══════════════════════════════════════════════════════
         상태 색상
         ═══════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="Color_OK"      Color="#FF1B8A3C"/>  <!-- 초록 — OK·정상 -->
    <SolidColorBrush x:Key="Color_NG"      Color="#FFD42828"/>  <!-- 빨강 — NG·정지 -->
    <SolidColorBrush x:Key="Color_Warn"    Color="#FF1A54AF"/>  <!-- 파랑으로 통합 — 경고·대기 -->
    <SolidColorBrush x:Key="Color_Idle"    Color="#FF8A9AB5"/>  <!-- 비활성 -->
    <SolidColorBrush x:Key="Color_Running" Color="#FF1A54AF"/>  <!-- 운전중 = 파랑 -->

    <!-- ═══════════════════════════════════════════════════════
         텍스트 계층 — 파란 배경 위 흰색 / 흰 배경 위 짙은 남색
         ═══════════════════════════════════════════════════════ -->
    <!-- 흰 배경 위 (카드·콘텐츠 영역) -->
    <SolidColorBrush x:Key="Text_Primary"   Color="#FF1A2540"/>  <!-- 주 텍스트 — 짙은 남색 -->
    <SolidColorBrush x:Key="Text_Secondary" Color="#FF3A5070"/>  <!-- 레이블 -->
    <SolidColorBrush x:Key="Text_Muted"     Color="#FF6A85A8"/>  <!-- 보조·단위 -->
    <SolidColorBrush x:Key="Text_Accent"    Color="#FF1A54AF"/>  <!-- 강조 텍스트 -->
    <!-- 파란 배경 위 흰색 전용 -->
    <SolidColorBrush x:Key="Text_OnBlue"    Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text_OnBlueSub" Color="#FFB8CEEC"/>  <!-- 파란 배경 위 보조 -->

    <!-- ═══════════════════════════════════════════════════════
         테두리
         ═══════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="Border_Normal" Color="#FFD0DDEF"/>
    <SolidColorBrush x:Key="Border_Active" Color="#FF1A54AF"/>

    <!-- ═══════════════════════════════════════════════════════
         LED 상태
         ═══════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="Led_On"     Color="#FF1B8A3C"/>   <!-- 초록 -->
    <SolidColorBrush x:Key="Led_Off"    Color="#FFC0CCDA"/>   <!-- 비활성 회색 -->
    <SolidColorBrush x:Key="Led_Red"    Color="#FFD42828"/>   <!-- 빨강 -->
    <SolidColorBrush x:Key="Led_Yellow" Color="#FF1A54AF"/>   <!-- 경고 → 파랑 통합 -->

    <!-- ================================================================
         컨트롤 스타일
         ================================================================ -->

    <!-- 기본 TextBlock -->
    <!--
        TextBlock 기본 스타일: Foreground는 상속으로 처리
        → 파란 컨테이너에서 TextElement.Foreground="White" 상속이 정상 동작
        → 흰 배경 영역은 Window.Foreground(Text_Primary)에서 상속
    -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Malgun Gothic"/>
        <Setter Property="FontSize"   Value="14"/>
    </Style>

    <!-- GroupBox -->
    <Style TargetType="GroupBox">
        <Setter Property="Foreground"      Value="{StaticResource Accent_Blue}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Border_Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin"          Value="0,4,0,4"/>
        <Setter Property="Padding"         Value="8,6"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FontWeight"      Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.RowSpan="2"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Background="{StaticResource Bg_Card}"/>
                        <Border Grid.Row="0"
                                Background="{StaticResource Accent_Blue}"
                                CornerRadius="6,6,0,0"
                                Padding="10,6"
                                Margin="1,1,1,0"
                                TextElement.Foreground="White">
                            <ContentPresenter ContentSource="Header"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ContentPresenter Grid.Row="1"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Btn_Default -->
    <Style x:Key="Btn_Default" TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource Bg_Card}"/>
        <Setter Property="Foreground"      Value="{StaticResource Text_Secondary}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Border_Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FontFamily"      Value="Malgun Gothic"/>
        <Setter Property="Height"          Value="34"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg_Input}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent_Blue}"/>
                            <Setter Property="Foreground" Value="{StaticResource Accent_Blue}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX=".97" ScaleY=".97"/></Setter.Value>
                            </Setter>
                            <Setter TargetName="bd" Property="RenderTransformOrigin" Value=".5,.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Btn_Blue — 파란 채움 버튼 (주 액션) -->
    <Style x:Key="Btn_Blue" TargetType="Button" BasedOn="{StaticResource Btn_Default}">
        <Setter Property="Background"  Value="{StaticResource Accent_Blue}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent_Blue}"/>
        <Setter Property="Foreground"  Value="White"/>
        <Setter Property="FontWeight"  Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent_Cyan}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent_Cyan}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX=".97" ScaleY=".97"/></Setter.Value>
                            </Setter>
                            <Setter TargetName="bd" Property="RenderTransformOrigin" Value=".5,.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Btn_Green — OK / 스타트 -->
    <Style x:Key="Btn_Green" TargetType="Button" BasedOn="{StaticResource Btn_Default}">
        <Setter Property="Background"  Value="#FFE8F5ED"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color_OK}"/>
        <Setter Property="Foreground"  Value="{StaticResource Color_OK}"/>
        <Setter Property="FontWeight"  Value="Bold"/>
    </Style>

    <!-- Btn_Red — NG / 정지 -->
    <Style x:Key="Btn_Red" TargetType="Button" BasedOn="{StaticResource Btn_Default}">
        <Setter Property="Background"  Value="#FFFDE8E8"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color_NG}"/>
        <Setter Property="Foreground"  Value="{StaticResource Color_NG}"/>
        <Setter Property="FontWeight"  Value="Bold"/>
    </Style>

    <!-- TabControl -->
    <Style TargetType="TabControl">
        <Setter Property="Background"      Value="{StaticResource Bg_Main}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Border_Normal}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground"      Value="{StaticResource Text_Muted}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FontFamily"      Value="Malgun Gothic"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Padding"         Value="16,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,3"
                            Margin="0,0,2,0">
                        <ContentPresenter ContentSource="Header"
                                          Margin="{TemplateBinding Padding}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}"
                                          TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="#FFF0F5FF"/>
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent_Blue}"/>
                            <Setter Property="Foreground" Value="{StaticResource Accent_Blue}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Accent_Blue}"/>
                            <Setter TargetName="TabBorder" Property="Background" Value="#FFF8FAFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid -->
    <Style TargetType="DataGrid">
        <Setter Property="Background"               Value="{StaticResource Bg_Card}"/>
        <Setter Property="Foreground"               Value="{StaticResource Text_Primary}"/>
        <Setter Property="BorderBrush"              Value="{StaticResource Border_Normal}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="RowBackground"            Value="{StaticResource Bg_Card}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Bg_Input}"/>
        <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Border_Normal}"/>
        <Setter Property="FontSize"                 Value="13"/>
        <Setter Property="FontFamily"               Value="Malgun Gothic"/>
        <Setter Property="ColumnHeaderHeight"       Value="34"/>
        <Setter Property="RowHeight"                Value="30"/>
        <Setter Property="SelectionMode"            Value="Single"/>
        <Setter Property="AutoGenerateColumns"      Value="False"/>
        <Setter Property="IsReadOnly"               Value="True"/>
        <Setter Property="CanUserResizeRows"        Value="False"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"       Value="{StaticResource Accent_Blue}"/>
        <Setter Property="Foreground"       Value="White"/>
        <Setter Property="FontWeight"       Value="Bold"/>
        <Setter Property="FontSize"         Value="13"/>
        <Setter Property="Padding"          Value="10,0"/>
        <Setter Property="BorderBrush"      Value="{StaticResource Accent_Cyan}"/>
        <Setter Property="BorderThickness"  Value="0,0,1,0"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource Text_Primary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFE8F0FF"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#FFD0E2FF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="8,0"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Accent_Blue}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ScrollBar -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource Bg_Input}"/>
        <Setter Property="Width"      Value="6"/>
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Background"      Value="{StaticResource Bg_Card}"/>
        <Setter Property="Foreground"      Value="{StaticResource Text_Primary}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Border_Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="7,5"/>
        <Setter Property="FontFamily"      Value="Malgun Gothic"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="CaretBrush"      Value="{StaticResource Accent_Blue}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent_Blue}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent_Cyan}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Background"      Value="{StaticResource Bg_Card}"/>
        <Setter Property="Foreground"      Value="{StaticResource Text_Primary}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Border_Normal}"/>
        <Setter Property="FontFamily"      Value="Malgun Gothic"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Height"          Value="32"/>
    </Style>

    <!-- DatePicker -->
    <Style TargetType="DatePicker">
        <Setter Property="Background"      Value="{StaticResource Bg_Card}"/>
        <Setter Property="Foreground"      Value="{StaticResource Text_Primary}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Border_Normal}"/>
        <Setter Property="FontFamily"      Value="Malgun Gothic"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Height"          Value="32"/>
    </Style>

    <!-- Separator -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Border_Normal}"/>
        <Setter Property="Margin"     Value="0,6"/>
    </Style>

</ResourceDictionary>
